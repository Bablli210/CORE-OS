{
  "expo": {
    "name": "GymOS",
    "slug": "gymos",
    "scheme": "gymos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "app.gymos.mobile", "supportsTablet": false },
    "android": { "package": "app.gymos.mobile", "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#ffffff" } },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/icon.png" },
    "plugins": ["expo-router", ["expo-notifications", { "icon": "./assets/icon.png" }]],
    "experiments": { "typedRoutes": false }
  }
}
